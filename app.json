{
  "expo": {
    "name": "Hệ thống dự báo thời tiết và hỗ trợ sức khỏe người dùng",
    "slug": "weather",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "weather",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F1FAEE",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F1FAEE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/archivo/900Black/Archivo_900Black.ttf",
            "./node_modules/@expo-google-fonts/bebas-neue/400Regular/BebasNeue_400Regular.ttf",
            "./node_modules/@expo-google-fonts/jetbrains-mono/400Regular/JetBrainsMono_400Regular.ttf",
            "./node_modules/@expo-google-fonts/jetbrains-mono/700Bold/JetBrainsMono_700Bold.ttf",
            "./node_modules/@expo-google-fonts/syne/400Regular/Syne_400Regular.ttf",
            "./node_modules/@expo-google-fonts/syne/800ExtraBold/Syne_800ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1FAEE"
        }
      ],
      [
        "expo-status-bar",
        {
          "hidden": false,
          "style": "dark"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép ứng dụng sử dụng vị trí khi bạn đang dùng ứng dụng để hiển thị điều kiện thời tiết tại khu vực của bạn."
        }
      ],
      "expo-sqlite",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép chọn ảnh đại diện từ thư viện ảnh.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#457B9D",
          "defaultChannel": "weather-actions"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
